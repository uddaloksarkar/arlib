import Arlib.Convexity.BFRotatingRoofCut
import Arlib.Convexity.LocalizationTransport

/-!
# Affine roofs and the coordinate form of the BF rotating pencil

This file supplies two algebraic interfaces used in the first variational case of the
Borell--KLS localization argument.  First, clipping a concave profile by any affine roof is
concave, and wherever that roof lies below the profile the clipped profile is literally affine.
Second, the pencil generated by the height direction and the normalized all-ones transverse
direction is exactly `roofCLM` after the measure-preserving `WithLp.toLp` identification.
-/

open Set MeasureTheory
open scoped BigOperators

namespace Arlib

variable {m : ℕ}

/-! ## Arbitrary affine roofs -/

/-- The minimum of a concave profile and an affine roof remains concave. -/
theorem concaveOn_min_affineRoof {ψ : ℝ → ℝ} (hψ : ConcaveOn ℝ (Icc (0 : ℝ) 1) ψ)
    (u v : ℝ) :
    ConcaveOn ℝ (Icc (0 : ℝ) 1) (fun t => min (ψ t) (u * t + v)) := by
  change ConcaveOn ℝ (Icc (0 : ℝ) 1) (ψ ⊓ fun t => u * t + v)
  exact hψ.inf (by simpa [add_comm] using
    (concaveOn_affine_real (convex_Icc (0 : ℝ) 1) v u))

/-- On every interval on which an affine roof is below the original profile, the roof-clipped
profile has that affine formula. -/
theorem profileAffineOn_min_affineRoof {ψ : ℝ → ℝ} {u v a b : ℝ}
    (hbelow : ∀ t ∈ Icc a b, u * t + v ≤ ψ t) :
    ProfileAffineOn (fun t => min (ψ t) (u * t + v)) a b := by
  exact ⟨u, v, fun t ht => min_eq_right (hbelow t ht)⟩

/-- **Arbitrary affine-roof strict-core improvement.**  If an affine roof is positive on the
open support, nonnegative at the endpoints, and lies below `ψ` on a core longer than a current
proper affine core, then its simplex roof cut preserves support and produces the longer affine
core.  Unlike the old constant-roof lemma, the roof here is the arbitrary output `u*t+v` of a
rotating pencil. -/
theorem affineRoof_cut_longer_affine_core {ψ : ℝ → ℝ}
    (hψ : ConcaveOn ℝ (Icc (0 : ℝ) 1) ψ)
    (hψ0 : ψ 0 = 0) (hψ1 : ψ 1 = 0)
    (hψpos : ∀ t ∈ Ioo (0 : ℝ) 1, 0 < ψ t)
    {u v a b δ : ℝ} (hlong : b - a < (1 - δ) - δ)
    (hell0 : 0 ≤ v) (hell1 : 0 ≤ u + v)
    (hellpos : ∀ t ∈ Ioo (0 : ℝ) 1, 0 < u * t + v)
    (hbelow : ∀ t ∈ Icc δ (1 - δ), u * t + v ≤ ψ t) :
    profileBody (coordinateSimplex m) ψ ∩ simplexRoof (fun t => u * t + v) =
        profileBody (coordinateSimplex m) (fun t => min (ψ t) (u * t + v)) ∧
      ConcaveOn ℝ (Icc (0 : ℝ) 1) (fun t => min (ψ t) (u * t + v)) ∧
      min (ψ 0) v = 0 ∧ min (ψ 1) (u + v) = 0 ∧
      (∀ t ∈ Ioo (0 : ℝ) 1, 0 < min (ψ t) (u * t + v)) ∧
      b - a < (1 - δ) - δ ∧
      ProfileAffineOn (fun t => min (ψ t) (u * t + v)) δ (1 - δ) := by
  have hψnonneg : ∀ t ∈ Icc (0 : ℝ) 1, 0 ≤ ψ t := by
    intro t ht
    rcases eq_or_lt_of_le ht.1 with rfl | ht0
    · rw [hψ0]
    rcases eq_or_lt_of_le ht.2 with rfl | ht1
    · rw [hψ1]
    exact (hψpos t ⟨ht0, ht1⟩).le
  have hellnonneg : ∀ t ∈ Icc (0 : ℝ) 1, 0 ≤ u * t + v := by
    intro t ht
    have hconv : u * t + v = (1 - t) * v + t * (u + v) := by ring
    rw [hconv]
    exact add_nonneg (mul_nonneg (sub_nonneg.mpr ht.2) hell0)
      (mul_nonneg ht.1 hell1)
  refine ⟨profileBody_coordinateSimplex_inter_roof hψnonneg hellnonneg,
    concaveOn_min_affineRoof hψ u v, ?_, ?_, ?_, hlong,
    profileAffineOn_min_affineRoof hbelow⟩
  · rw [hψ0, min_eq_left hell0]
  · rw [hψ1, min_eq_left hell1]
  · intro t ht
    exact lt_min (hψpos t ht) (hellpos t ht)

/-! ## The normalized height/tail-sum pencil -/

/-- Unit height direction in the Euclidean realization of the profile body. -/
noncomputable def roofHeightUnit (m : ℕ) : EuclideanSpace ℝ (Fin (m + 1)) :=
  EuclideanSpace.single 0 (1 : ℝ)

/-- The normalized all-ones direction in the transverse coordinates. -/
noncomputable def roofTailUnit (m : ℕ) : EuclideanSpace ℝ (Fin (m + 1)) :=
  WithLp.toLp 2 (Fin.cons 0 (fun _ : Fin m => (Real.sqrt m)⁻¹))

@[simp] theorem roofHeightUnit_apply_zero : roofHeightUnit m 0 = 1 := by
  simp [roofHeightUnit]

@[simp] theorem roofHeightUnit_apply_succ (i : Fin m) : roofHeightUnit m i.succ = 0 := by
  simp [roofHeightUnit, Fin.succ_ne_zero]

@[simp] theorem roofTailUnit_apply_zero : roofTailUnit m 0 = 0 := by
  rfl

@[simp] theorem roofTailUnit_apply_succ (i : Fin m) :
    roofTailUnit m i.succ = (Real.sqrt m)⁻¹ := by
  rfl

theorem inner_roofHeightUnit_self :
    inner ℝ (roofHeightUnit m) (roofHeightUnit m) = (1 : ℝ) := by
  exact inner_single_one_self 0

theorem inner_roofHeightUnit_roofTailUnit :
    inner ℝ (roofHeightUnit m) (roofTailUnit m) = (0 : ℝ) := by
  rw [roofHeightUnit, inner_single_one]
  exact roofTailUnit_apply_zero

theorem inner_roofTailUnit_self (hm : 0 < m) :
    inner ℝ (roofTailUnit m) (roofTailUnit m) = (1 : ℝ) := by
  rw [PiLp.inner_apply]
  simp only [RCLike.inner_apply, conj_trivial, roofTailUnit_apply_zero,
    zero_mul, Fin.sum_univ_succ, roofTailUnit_apply_succ]
  rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  have hs : 0 < Real.sqrt (m : ℝ) := Real.sqrt_pos.2 (by exact_mod_cast hm)
  rw [zero_add]
  field_simp
  exact (Real.sq_sqrt (by positivity : (0 : ℝ) ≤ m)).symm

/-- The Euclidean pencil evaluates as height plus normalized tail sum. -/
theorem pencilFun_roof_apply (θ : ℝ)
    (x : EuclideanSpace ℝ (Fin (m + 1))) :
    pencilFun (roofHeightUnit m) (roofTailUnit m) θ x =
      Real.cos θ * x 0 + (Real.sin θ / Real.sqrt m) * ∑ i : Fin m, x i.succ := by
  rw [pencilFun_apply, roofHeightUnit, inner_single_one, PiLp.inner_apply]
  simp only [RCLike.inner_apply, conj_trivial, roofTailUnit_apply_zero, mul_zero,
    Fin.sum_univ_succ, roofTailUnit_apply_succ, zero_add]
  congr 1
  rw [div_eq_mul_inv, Finset.mul_sum]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  ring

/-- After `WithLp.toLp`, the normalized BF pencil is exactly `roofCLM`. -/
theorem pencilFun_roof_toLp (θ : ℝ) (x : Fin (m + 1) → ℝ) :
    pencilFun (roofHeightUnit m) (roofTailUnit m) θ (WithLp.toLp 2 x) =
      roofCLM (m := m) (Real.cos θ) (Real.sin θ / Real.sqrt m) x := by
  rw [pencilFun_roof_apply, roofCLM_apply]
  rfl

/-- Exact pullback of every selected pencil halfspace to the raw coordinate roof model. -/
theorem preimage_halfSpace_pencilFun_roof (θ c : ℝ) (side : Bool) :
    (WithLp.toLp 2 : (Fin (m + 1) → ℝ) → EuclideanSpace ℝ (Fin (m + 1))) ⁻¹'
        halfSpace (pencilFun (roofHeightUnit m) (roofTailUnit m) θ) c side =
      halfSpace (roofCLM (m := m) (Real.cos θ) (Real.sin θ / Real.sqrt m)) c side := by
  ext x
  cases side <;> simp [halfSpace, pencilFun_roof_toLp]

/-- Every selected side of the coordinate roof pencil has exactly one of the two lower-roof
orientations, one of the two upper-shell orientations, or is the vertical degeneracy `sin θ=0`.
This is exhaustive and makes the remaining BF case split explicit. -/
theorem roofPencil_orientation (θ : ℝ) (side : Bool) :
    Real.sin θ = 0 ∨
      ((side = true ∧ 0 < Real.sin θ) ∨ (side = false ∧ Real.sin θ < 0)) ∨
      ((side = false ∧ 0 < Real.sin θ) ∨ (side = true ∧ Real.sin θ < 0)) := by
  rcases lt_trichotomy (Real.sin θ) 0 with hneg | hzero | hpos
  · right
    cases side <;> simp_all
  · exact Or.inl hzero
  · right
    cases side <;> simp_all

/-- Set-level form of `roofPencil_orientation`.  Outside the vertical degeneracy, the selected
halfspace is proved to be either a lower simplex roof (closed or open) or exactly the opposite
upper shell (open or closed). -/
theorem roofPencil_halfSpace_geometry (hm : 0 < m) (θ c : ℝ) (side : Bool) :
    Real.sin θ = 0 ∨
      ((halfSpace (roofCLM (m := m) (Real.cos θ) (Real.sin θ / Real.sqrt m)) c side =
          simplexRoof (fun t =>
            (c - Real.cos θ * t) / (Real.sin θ / Real.sqrt m))) ∨
       (halfSpace (roofCLM (m := m) (Real.cos θ) (Real.sin θ / Real.sqrt m)) c side =
          simplexBelowRoofOpen (fun t =>
            (c - Real.cos θ * t) / (Real.sin θ / Real.sqrt m)))) ∨
      ((halfSpace (roofCLM (m := m) (Real.cos θ) (Real.sin θ / Real.sqrt m)) c side =
          simplexAboveRoof (fun t =>
            (c - Real.cos θ * t) / (Real.sin θ / Real.sqrt m))) ∨
       (halfSpace (roofCLM (m := m) (Real.cos θ) (Real.sin θ / Real.sqrt m)) c side =
          {x | (c - Real.cos θ * x 0) / (Real.sin θ / Real.sqrt m) ≤
            ∑ i, Fin.tail x i})) := by
  have hsqrt : 0 < Real.sqrt (m : ℝ) := Real.sqrt_pos.2 (by exact_mod_cast hm)
  rcases roofPencil_orientation θ side with hzero | hlower | hupper
  · exact Or.inl hzero
  · right; left
    rcases hlower with ⟨rfl, hsin⟩ | ⟨rfl, hsin⟩
    · exact Or.inl (halfSpace_roofCLM_true_of_pos (div_pos hsin hsqrt))
    · exact Or.inr (halfSpace_roofCLM_false_of_neg (div_neg_of_neg_of_pos hsin hsqrt))
  · right; right
    rcases hupper with ⟨rfl, hsin⟩ | ⟨rfl, hsin⟩
    · exact Or.inl (halfSpace_roofCLM_false_of_pos (div_pos hsin hsqrt))
    · exact Or.inr (halfSpace_roofCLM_true_of_neg (div_neg_of_neg_of_pos hsin hsqrt))

/-! ## Constraint-preserving pencil selection in raw roof coordinates -/

/-- **The existing flat-pencil selector, specialized and transported to the coordinate roof
model.**  Starting from Euclidean ambient data, the selected constraints are stated directly on
the raw `Fin (m+1) → ℝ` preimage body and a `roofCLM` halfspace.  The last conjunct gives the
exhaustive geometric alternative: lower roof, upper shell, or the vertical (`sin θ = 0`) cut.

Thus no unidentified continuous functional remains between the selector and the simplex-profile
Fubini lemmas. -/
theorem exists_coordinateRoofPencil_cut_zero_pos (hm : 0 < m)
    {C : Set (EuclideanSpace ℝ (Fin (m + 1)))}
    {g₁ g₂ : EuclideanSpace ℝ (Fin (m + 1)) → ℝ}
    (hC : MeasurableSet C) (hg₁ : IntegrableOn g₁ C) (hg₂ : IntegrableOn g₂ C)
    (hz : ∫ x in C, g₁ x = 0) (hp : 0 < ∫ x in C, g₂ x) (r s : ℝ) :
    ∃ (θ : ℝ) (side : Bool),
      (∫ x in
          (WithLp.toLp 2 : (Fin (m + 1) → ℝ) → EuclideanSpace ℝ (Fin (m + 1))) ⁻¹' C ∩
            halfSpace (roofCLM (m := m) (Real.cos θ)
              (Real.sin θ / Real.sqrt m)) (pencilLevel r s θ) side,
          g₁ (WithLp.toLp 2 x)) = 0 ∧
      0 < ∫ x in
          (WithLp.toLp 2 : (Fin (m + 1) → ℝ) → EuclideanSpace ℝ (Fin (m + 1))) ⁻¹' C ∩
            halfSpace (roofCLM (m := m) (Real.cos θ)
              (Real.sin θ / Real.sqrt m)) (pencilLevel r s θ) side,
          g₂ (WithLp.toLp 2 x) ∧
      (Real.sin θ = 0 ∨
        ((side = true ∧ 0 < Real.sin θ) ∨ (side = false ∧ Real.sin θ < 0)) ∨
        ((side = false ∧ 0 < Real.sin θ) ∨ (side = true ∧ Real.sin θ < 0))) := by
  obtain ⟨θ, side, hzero, hpos⟩ := exists_flat_cut_zero_pos
    (inner_roofHeightUnit_self (m := m)) (inner_roofTailUnit_self hm)
    (inner_roofHeightUnit_roofTailUnit (m := m)) hC hg₁ hg₂ hz hp r s
  refine ⟨θ, side, ?_, ?_, roofPencil_orientation θ side⟩
  · have heq := setIntegral_preimage_toLp g₁
      (C ∩ halfSpace (pencilFun (roofHeightUnit m) (roofTailUnit m) θ)
        (pencilLevel r s θ) side)
    rw [preimage_inter, preimage_halfSpace_pencilFun_roof] at heq
    exact heq.trans hzero
  · have heq := setIntegral_preimage_toLp g₂
      (C ∩ halfSpace (pencilFun (roofHeightUnit m) (roofTailUnit m) θ)
        (pencilLevel r s θ) side)
    rw [preimage_inter, preimage_halfSpace_pencilFun_roof] at heq
    rw [heq]
    exact hpos

end Arlib

